{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:showpapers:operations:2",
  "title": "ShowPapers offline rich-content operations v2",
  "$comment": "The tool additionally checks caller-supplied scope constraints, input revision, revision overflow, resolved references, payload bounds and full resulting snapshot validity. operationId is correlation only; there is no durable replay ledger. Protocol 2 accepts only archive format 2. Note add/edit use a complete atomic document, never plain text or partial span patches; all previous and incoming Paper references need explicit scope. Runtime additionally enforces UTF-16 length and scalar boundaries, start < end <= text length, nonoverlapping link ranges, in-archive Paper resolution, exact manifest Paper references, byte limits and no unknown fields. Bold/italic marks may overlap and are preserved in order. This content profile does not encode legacy checklist items or internal vault metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "operationId",
    "collectionId",
    "expectedRevision",
    "operations"
  ],
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 2
    },
    "operationId": {
      "$ref": "#/$defs/id"
    },
    "collectionId": {
      "$ref": "#/$defs/id"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "title",
              "document"
            ],
            "properties": {
              "type": {
                "const": "note.add"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "$ref": "#/$defs/title"
              },
              "document": {
                "$ref": "#/$defs/noteDocument"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "document"
            ],
            "properties": {
              "type": {
                "const": "note.edit"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "document": {
                "$ref": "#/$defs/noteDocument"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "note.remove"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "recordType",
              "title"
            ],
            "properties": {
              "type": {
                "const": "record.rename"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "recordType": {
                "enum": [
                  "paper",
                  "note"
                ]
              },
              "title": {
                "$ref": "#/$defs/title"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "name",
              "noteIds",
              "paperIds"
            ],
            "properties": {
              "type": {
                "const": "folder.add"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^(?![ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])(?![\\s\\S]*[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]$)[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
              },
              "noteIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "maxItems": 100,
                "uniqueItems": true
              },
              "paperIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "maxItems": 100,
                "uniqueItems": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "name"
            ],
            "properties": {
              "type": {
                "const": "folder.rename"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^(?![ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])(?![\\s\\S]*[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]$)[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "folder.remove"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "noteIds",
              "paperIds"
            ],
            "properties": {
              "type": {
                "const": "folder.addMembers"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "noteIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "maxItems": 100,
                "uniqueItems": true
              },
              "paperIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "maxItems": 100,
                "uniqueItems": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "noteIds",
              "paperIds"
            ],
            "properties": {
              "type": {
                "const": "folder.removeMembers"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "noteIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "maxItems": 100,
                "uniqueItems": true
              },
              "paperIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "maxItems": 100,
                "uniqueItems": true
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])(?![\\s\\S]*[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]$)[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "mark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "style"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "style": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        }
      }
    },
    "paperLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "paperId"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "paperId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "noteDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noteVersion",
        "text",
        "marks",
        "paperIds",
        "paperLinks"
      ],
      "properties": {
        "noteVersion": {
          "type": "integer",
          "const": 1
        },
        "text": {
          "type": "string",
          "maxLength": 32768,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f\\ud800-\\udfff]*$",
          "x-showpapers-maxUtf16CodeUnits": 32768,
          "description": "Exact modern Scratch text. LF and tab are allowed; carriage returns and other control characters are rejected. Bullet and checkbox state are literal line prefixes."
        },
        "marks": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "$ref": "#/$defs/mark"
          }
        },
        "paperIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "paperLinks": {
          "type": "array",
          "maxItems": 640,
          "items": {
            "$ref": "#/$defs/paperLink"
          }
        }
      }
    }
  }
}
