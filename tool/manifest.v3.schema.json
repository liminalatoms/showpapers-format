{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:showpapers:format:manifest:3",
  "title": "ShowPapers readable manifest v3",
  "$comment": "Format 3 stores complete bounded Scratch record v1 JSON, validated by note-record.schema.json and the runtime. Note paperIds must exactly match the first-occurrence union of legacy row references in row order, then modern document references. Runtime also checks canonical paths, resolved references, global record IDs, digests, byte limits and archive safety. Offline edits use operation protocol 3 or 4 with complete records. The field set is closed: reading output, reviewed details, People and review history are not part of this profile, and a file is a selected collection, never a full-vault backup.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "protection",
    "collection",
    "originals",
    "notes",
    "folders"
  ],
  "properties": {
    "format": {
      "const": "showpapers"
    },
    "formatVersion": {
      "const": 3,
      "type": "integer"
    },
    "protection": {
      "const": "readable"
    },
    "collection": {
      "$ref": "#/$defs/collection"
    },
    "originals": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/original"
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "folders": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/folder"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])(?![\\s\\S]*[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]$)[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "title": {
          "$ref": "#/$defs/title"
        }
      }
    },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "path",
        "size",
        "sha256",
        "mediaType"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "path": {
          "type": "string",
          "pattern": "^originals/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.(pdf|png|jpg|webp)$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mediaType": {
          "enum": [
            "application/pdf",
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "path",
        "size",
        "sha256",
        "encoding",
        "paperIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/noteTitle"
        },
        "path": {
          "type": "string",
          "pattern": "^notes/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.json$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 524288
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "encoding": {
          "const": "utf-8"
        },
        "paperIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 100,
          "description": "Exact ordered first-occurrence union of legacy row paperIds followed by document.paperIds. No references may be omitted."
        }
      }
    },
    "folder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "paperIds",
        "noteIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^(?![ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])(?![\\s\\S]*[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]$)[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
        },
        "paperIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "noteIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 100
        }
      }
    },
    "noteTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "anyOf": [
          {
            "pattern": "^[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*$"
          },
          {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]"
          }
        ]
      },
      "description": "Nonblank native Scratch label, at most 160 Unicode scalars. Edge whitespace is preserved; controls and surrogate code points are rejected."
    }
  }
}
