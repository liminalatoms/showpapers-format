{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:showpapers:format:build-spec:1",
  "title": "ShowPapers local build specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "collection",
    "originals",
    "notes",
    "folders"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 1
    },
    "collection": {
      "$ref": "#/$defs/collection"
    },
    "originals": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "source"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "A regular file inside the build-spec directory. Absolute paths, dot segments and symbolic links are rejected."
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "source",
          "paperIds"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "A regular file inside the build-spec directory. Absolute paths, dot segments and symbolic links are rejected."
          },
          "paperIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "uniqueItems": true,
            "maxItems": 100
          }
        }
      }
    },
    "folders": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/folder"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])(?![\\s\\S]*[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]$)[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "title": {
          "$ref": "#/$defs/title"
        }
      }
    },
    "folder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "paperIds",
        "noteIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^(?![ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])(?![\\s\\S]*[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]$)[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
        },
        "paperIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "noteIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 100
        }
      }
    }
  }
}
