{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:showpapers:format:build-spec:3",
  "title": "ShowPapers readable build-spec v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "collection",
    "originals",
    "notes",
    "folders"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 3
    },
    "collection": {
      "$ref": "#/$defs/collection"
    },
    "originals": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "source"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "A regular file inside the build-spec directory. Absolute paths, dot segments and symbolic links are rejected."
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "source",
          "paperIds"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/noteTitle"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "A regular UTF-8 JSON Scratch record v1 file inside the build-spec directory, up to 512 KiB. No absolute paths, dot segments or symlinks. Preserve both legacy rows and any modern document; no conversion is performed."
          },
          "paperIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "uniqueItems": true,
            "maxItems": 100,
            "description": "Exact ordered first-occurrence union of legacy row paperIds followed by document.paperIds. No references may be omitted."
          }
        }
      }
    },
    "folders": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/folder"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])(?![\\s\\S]*[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]$)[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "title": {
          "$ref": "#/$defs/title"
        }
      }
    },
    "folder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "paperIds",
        "noteIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^(?![ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])(?![\\s\\S]*[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]$)[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
        },
        "paperIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "noteIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 100
        }
      }
    },
    "noteTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "anyOf": [
          {
            "pattern": "^[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*$"
          },
          {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]"
          }
        ]
      },
      "description": "Nonblank native Scratch label, at most 160 Unicode scalars. Edge whitespace is preserved; controls and surrogate code points are rejected."
    }
  },
  "$comment": "Format 3 stores complete bounded Scratch record v1 JSON, validated by note-record.schema.json and the runtime. Note paperIds must exactly match the first-occurrence union of legacy row references in row order, then modern document references. Runtime also checks canonical paths, resolved references, global record IDs, digests, byte limits and archive safety. Offline edits use operation protocol 3 or 4 with complete records. The field set is closed: reading output, reviewed details, People and review history are not part of this profile, and a file is a selected collection, never a full-vault backup."
}
