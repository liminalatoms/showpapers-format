{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:showpapers:contents:2",
  "title": "ShowPapers contents statement v2",
  "$comment": "Derived by `contents` for a validated profile 4 archive and never stored inside it. Content-free: no titles, names, values or text. IDs and digests remain private metadata and are not analytics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "contentsVersion",
    "specificationVersion",
    "format",
    "formatVersion",
    "protection",
    "collectionId",
    "revision",
    "manifestSchema",
    "originals",
    "counts",
    "totalPayloadBytes",
    "verified",
    "warnings",
    "notIncluded",
    "selectedCollection",
    "fullVaultBackup"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "contentsVersion": {
      "const": 2,
      "type": "integer"
    },
    "specificationVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 20,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "format": {
      "const": "showpapers"
    },
    "formatVersion": {
      "const": 4,
      "type": "integer"
    },
    "protection": {
      "const": "readable"
    },
    "collectionId": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "manifestSchema": {
      "const": "urn:showpapers:format:manifest:4"
    },
    "originals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "mediaType",
          "size",
          "sha256",
          "paperRecord",
          "reading"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "paperRecord": {
            "type": "boolean"
          },
          "reading": {
            "type": "boolean"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originals",
        "papers",
        "readings",
        "notes",
        "folders",
        "people",
        "relationships",
        "agents",
        "details",
        "readingDetails",
        "personDetails",
        "agentDetails",
        "confirmedDetails",
        "pendingAgentValues",
        "removedSuggestions",
        "reminders",
        "pinnedPapers"
      ],
      "properties": {
        "originals": {
          "type": "integer",
          "minimum": 0
        },
        "papers": {
          "type": "integer",
          "minimum": 0
        },
        "readings": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "integer",
          "minimum": 0
        },
        "folders": {
          "type": "integer",
          "minimum": 0
        },
        "people": {
          "type": "integer",
          "minimum": 0
        },
        "relationships": {
          "type": "integer",
          "minimum": 0
        },
        "agents": {
          "type": "integer",
          "minimum": 0
        },
        "details": {
          "type": "integer",
          "minimum": 0
        },
        "readingDetails": {
          "type": "integer",
          "minimum": 0
        },
        "personDetails": {
          "type": "integer",
          "minimum": 0
        },
        "agentDetails": {
          "type": "integer",
          "minimum": 0
        },
        "confirmedDetails": {
          "type": "integer",
          "minimum": 0
        },
        "pendingAgentValues": {
          "type": "integer",
          "minimum": 0
        },
        "removedSuggestions": {
          "type": "integer",
          "minimum": 0
        },
        "reminders": {
          "type": "integer",
          "minimum": 0
        },
        "pinnedPapers": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "totalPayloadBytes": {
      "type": "integer",
      "minimum": 0
    },
    "verified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "everyDeclaredPayloadPresent",
        "noUndeclaredEntries",
        "sizesAndSha256",
        "mediaSignatures",
        "references",
        "nativeLimits"
      ],
      "properties": {
        "everyDeclaredPayloadPresent": {
          "const": true
        },
        "noUndeclaredEntries": {
          "const": true
        },
        "sizesAndSha256": {
          "const": true
        },
        "mediaSignatures": {
          "const": true
        },
        "references": {
          "const": true
        },
        "nativeLimits": {
          "const": true
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "count"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "notIncluded": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "selectedCollection": {
      "const": true
    },
    "fullVaultBackup": {
      "const": false
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
